# Copy this file to `.env` and fill in the absolute paths of your local
# checkouts. `.env` is loaded automatically at import by
# equiv_primitive/policies/utils/repo_paths.py -- there is nothing to `source` or
# `export` by hand. The real `.env` is gitignored. A value already present in
# your shell environment takes precedence over the one set here.
#
# REPO_ROOT is detected automatically from the .repo_root marker; no entry needed.

# TAMP / pddlstream_aloha checkout. Provides the
# examples.pybullet.aloha_real.openworld_aloha render utilities used by
# equiv_primitive/policies/aloha_wrapper.py.
export TAMP_ROOT=/path/to/pddlstream_aloha

# dexmimicgen checkout. Provides the sim env and scripts.playback_depth helpers
# used by equiv_primitive/policies/eval_dmg_perskill.py.
export DEXMIMICGEN_ROOT=/path/to/dexmimicgen
